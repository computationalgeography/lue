#pragma once
#include <cstdint>
#include <string>


namespace lue {

    inline auto version() -> std::string
    {
        return "${LUE_VERSION}";
    }


    inline auto major_version() -> std::uint32_t
    {
        return ${LUE_VERSION_MAJOR};
    }


    inline auto minor_version() -> std::uint32_t
    {
        return ${LUE_VERSION_MINOR};
    }


    inline auto patch_version() -> std::uint32_t
    {
        return ${LUE_VERSION_PATCH};
    }


    inline auto tweak_version() -> std::uint32_t
    {
        return ${LUE_VERSION_TWEAK} + 0;
    }

}  // namespace lue
