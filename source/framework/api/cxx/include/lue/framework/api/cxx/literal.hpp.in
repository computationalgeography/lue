#pragma once
#include "lue/framework/api/cxx/variant_wrapper.hpp"
#include <cstdint>


namespace lue::api {

    /*!
        @brief      Class for representing literals
    */
    class Literal:
        // clang-format off
        public VariantWrapper<
            {{ Elements | join(", ") }}
        >  // clang-format on

    {

        public:

            using VariantWrapper::VariantWrapper;
    };

}  // namespace lue::api
