    template class SerialRoutePartition<{{ RouteID }}, {{ rank }}>;

    namespace server {

        template class SerialRoutePartition<{{ RouteID }}, {{ rank }}>;

    }  // namespace server
}  // namespace lue


LUE_REGISTER_SERIAL_ROUTE_PARTITION({{ RouteID }}, {{ rank }});

// clang-format on
