#include "lue/py/framework/core/partitioned_array.hpp"


namespace lue::framework {

    // clang-format off
    void bind_partitioned_array_{{ Element | replace("::", "_") }}_{{ rank }}(pybind11::module& module)
    {
        bind_partitioned_array<{{ Element }}, {{ rank }}>(module);
    }
    // clang-format on

}  // namespace lue::framework
